{
  "schemaVersion": 1,
  "id": "io.github.cesarfilho.kbd-backlight",
  "name": "Keyboard Backlight",
  "version": "0.1.0",
  "author": "cesarfilho",
  "license": "MIT",
  "description": "Keyboard backlight control for the bar: click toggles, scroll changes brightness, right click cycles colors. Optionally follows the theme accent.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "BarWidget.qml" },
  "barWidget": {
    "displayName": "Keyboard Backlight",
    "description": "Toggle and dim the keyboard backlight, cycle its color.",
    "category": "Hardware",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": { "stepPercent": 10, "refreshIntervalSec": 5 },
    "schema": [
      { "key": "stepPercent", "type": "integer", "label": "Scroll step (%)", "min": 1, "max": 50, "step": 1, "defaultValue": 10 },
      { "key": "refreshIntervalSec", "type": "integer", "label": "Refresh interval (seconds)", "min": 1, "max": 60, "step": 1, "defaultValue": 5 }
    ]
  }
}
